# ============================================================
# Shifa AI Backend — Environment Configuration
# Copy this file to .env and fill in your own credentials.
# NEVER commit .env to Git.
# ============================================================

# ── Google Gemini (https://aistudio.google.com/apikey) ──────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── Whisper / Speech-to-Text ────────────────────────────────────
# Provider: 'openai' or 'groq'
WHISPER_PROVIDER=groq

# OpenAI Whisper (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_WHISPER_MODEL=whisper-1

# Groq Whisper (free tier — https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3

# ── Network ─────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=60

# Public URL of this backend (used for camera links sent via WhatsApp).
# In production use your actual domain or ngrok URL.
BACKEND_PUBLIC_URL=https://your-ngrok-url.ngrok-free.dev

# URL of the WhatsApp integration server (for vital-result callbacks).
WHATSAPP_INTEGRATION_URL=http://localhost:5000

# ── Emergency Engine ────────────────────────────────────────────
# MOCK = simulated dispatch for demo | PRODUCTION = authorised provider only
EMERGENCY_DISPATCH_MODE=MOCK
DASHBOARD_SECRET_TOKEN=your_random_dashboard_token_here
EMERGENCY_COOLDOWN_MINUTES=10

# ── Meta WhatsApp (for vital result notifications) ──────────────
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here

# ── Environment ─────────────────────────────────────────────────
ENVIRONMENT=development
