# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI Whisper (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# Optional: use Groq Whisper instead of OpenAI (set WHISPER_PROVIDER=groq)
WHISPER_PROVIDER=openai
GROQ_API_KEY=

# Network timeout (seconds) for AI service calls
REQUEST_TIMEOUT_SECONDS=30

# Public URL of this backend (used for camera links sent via WhatsApp).
# In production use your actual domain or ngrok URL.
BACKEND_PUBLIC_URL=https://your-ngrok-url.ngrok.io

# URL of the WhatsApp integration server (for vital-result callbacks).
# Leave empty to disable proactive result notifications.
WHATSAPP_INTEGRATION_URL=

# Emergency Engine
# MOCK = simulated dispatch for demo | PRODUCTION = authorised provider only
EMERGENCY_DISPATCH_MODE=MOCK
DASHBOARD_SECRET_TOKEN=change_me_in_production
EMERGENCY_COOLDOWN_MINUTES=10
