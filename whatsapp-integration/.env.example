# ============================================================
# Shifa AI WhatsApp Integration — Environment Configuration
# Copy this file to .env and fill in your own credentials.
# NEVER commit .env to Git.
# ============================================================

# ── Meta WhatsApp Business API ──────────────────────────────────
# Get from: https://developers.facebook.com/apps
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_VERIFY_TOKEN=your_custom_verify_token_here

# ── Backend FastAPI Service ─────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
WHISPER_ENDPOINT=/api/transcribe

# ── Integration Server ──────────────────────────────────────────
INTEGRATION_HOST=0.0.0.0
INTEGRATION_PORT=5000

# ── ngrok ───────────────────────────────────────────────────────
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
NGROK_PUBLIC_URL=https://xxxxx.ngrok-free.dev

# ── Audio temp directory ────────────────────────────────────────
AUDIO_TEMP_DIR=audio_temp

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30

# ── Emergency Engine ────────────────────────────────────────────
EMERGENCY_DISPATCH_MODE=MOCK
DASHBOARD_SECRET_TOKEN=your_random_dashboard_token_here

# ── Environment ─────────────────────────────────────────────────
ENVIRONMENT=development
